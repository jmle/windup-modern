FROM registry.access.redhat.com/ubi9/openjdk-17:latest AS builder

USER 0
WORKDIR /build

COPY pom.xml .
RUN mvn dependency:go-offline -q || true

COPY src/ src/
RUN mvn package -DskipTests -q

FROM registry.access.redhat.com/ubi9/ubi AS index-download
RUN dnf install -y wget unzip --setopt=install_weak_deps=False && dnf clean all
WORKDIR /maven-index-data
RUN set -e; \
    URL=$(wget -qO- https://api.github.com/repos/konveyor/maven-search-index/releases/latest \
      | grep '"browser_download_url".*maven-index-data.*\.zip' \
      | sed -E 's/.*"browser_download_url": "([^"]+)".*/\1/' \
      || true); \
    if [ -z "$URL" ]; then \
      echo "Falling back to direct download"; \
      URL=https://github.com/konveyor/maven-search-index/releases/download/v2025-11-11/maven-index-data-v20251112021242.zip; \
    fi; \
    wget -q "$URL" -O maven-index-data.zip && \
    unzip maven-index-data.zip && \
    rm maven-index-data.zip
RUN wget -q https://raw.githubusercontent.com/konveyor/java-analyzer-bundle/main/hack/maven.default.index \
    -O /maven-index-data/maven.default.index

FROM registry.access.redhat.com/ubi9/ubi-minimal AS runtime

RUN microdnf install -y java-21-openjdk-headless java-1.8.0-openjdk-headless tar gzip --nodocs \
    --setopt=install_weak_deps=0 && microdnf clean all && rm -rf /var/cache/dnf && \
    ln -sf /usr/lib/jvm/java-21-openjdk-* /usr/lib/jvm/java-21-openjdk && \
    ln -sf /usr/lib/jvm/java-1.8.0-openjdk-* /usr/lib/jvm/java-1.8.0-openjdk

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV JAVA8_HOME=/usr/lib/jvm/java-1.8.0-openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

WORKDIR /addon

COPY --from=builder /build/target/java-analyzer-provider-1.0.0-SNAPSHOT.jar /usr/local/bin/java-provider.jar

# Wrapper script so kantra can invoke it as java-external-provider --port N --name java
# Our JavaProviderMain silently ignores flags it doesn't handle (--name, --log-level, --socket, etc.)
RUN printf '#!/bin/sh\nexec java -XX:+UseZGC -XX:+ZGenerational -jar /usr/local/bin/java-provider.jar "$@"\n' \
    > /usr/local/bin/java-external-provider && \
    chmod +x /usr/local/bin/java-external-provider

# Paths that kantra's default providerSpecificConfig references
RUN mkdir -p /jdtls/bin && \
    touch /jdtls/bin/jdtls && \
    mkdir -p /jdtls/java-analyzer-bundle/java-analyzer-bundle.core/target && \
    touch /jdtls/java-analyzer-bundle/java-analyzer-bundle.core/target/java-analyzer-bundle.core-1.0.0-SNAPSHOT.jar

# Maven SHA-1 index for binary artifact identification and open-source dependency labels
COPY --from=index-download /maven-index-data/central.archive-metadata.txt /usr/local/etc/maven-index.txt
COPY --from=index-download /maven-index-data/maven.default.index /usr/local/etc/maven.default.index

RUN chgrp -R 0 /addon && chmod -R g=u /addon
USER 1001

ENV HOME=/addon
EXPOSE 14651

ENTRYPOINT ["java-external-provider"]
CMD ["--port", "14651"]
